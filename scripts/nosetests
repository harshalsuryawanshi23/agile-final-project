#!/usr/bin/env python3
"""Compatibility launcher for Nose 1.3.7 on Python 3.11+.

Nose's legacy suite module references collections.Callable, which was removed
from Python 3.10. Restore the alias before importing Nose, then delegate to
its normal command-line entry point.
"""

import collections
import collections.abc
import sys

if not hasattr(collections, "Callable"):
    collections.Callable = collections.abc.Callable

from nose.core import main

if __name__ == "__main__":
    sys.exit(main())
